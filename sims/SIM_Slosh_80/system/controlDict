FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     interFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         20.0;

deltaT          0.001;

writeControl    adjustableRunTime;
writeInterval   0.02;

adjustTimeStep  yes;
maxCo           0.20;
maxAlphaCo      0.20;

