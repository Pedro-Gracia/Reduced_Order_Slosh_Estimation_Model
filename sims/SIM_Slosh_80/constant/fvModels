FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}

lateralPulse
{
    type            accelerationSource;
    active          yes;

    selectionMode   all;

    U               U;

    // Peak lateral acceleration direction
    value           (1.0 0 0);

    velocity        scale;

    scale
    {
        type        table;
        values
        (
            (0.00   0.00)
            (0.10   0.00)
            (0.20   0.05)
            (0.30   0.10)
            (0.40   0.15)
            (0.50   0.20)
            (0.60   0.15)
            (0.70   0.10)
            (0.80   0.05)
            (0.90   0.00)
            (1.00   0.00)
            (1.10   0.0)
            (1.20   0.0)
            (1.30   0.0)
            (1.40   0.0)
            (1.80   0.0)
            (2.50   0.0)
            (3.50   0.0)
            (4.00   0.0)
        );
    }
}

