FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

phases (water air);

water
{
    transportModel Newtonian;
    nu 1e-6;
    rho 1000;
}

air
{
    transportModel Newtonian;
    nu 1.5e-5;
    rho 1;
}

sigma 0.07;

